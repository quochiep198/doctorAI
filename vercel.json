{
  "rewrites": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/AIDoctor/static/assets/$1"
    },
    {
      "src": "/favicon.ico",
      "dest": "/AIDoctor/static/favicon.ico"
    },
    {
      "src": "/(.*)",
      "dest": "/AIDoctor/static/index.html"
    }
  ]
}
